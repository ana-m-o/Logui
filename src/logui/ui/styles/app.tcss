/* -------------------------------------------------------------------------- */
/*  Global                                                                    */
/* -------------------------------------------------------------------------- */

#layout {
    height: 1fr;

    #main {
        width: 1fr;
        padding: 1 2;
    }
}

Sidebar {
    width: 24;
    background: $panel;
    border-right: solid $primary;
    padding: 1 0;

    #nav-list {
        background: $panel;
        border: none;
        padding: 0;
        height: 1fr;

        & > NavItem {
            padding: 1 2;
            background: $panel;
            border: none;

            &.active {
                background: $accent 25%;
                border-left: thick $accent;
            }

            &.-highlight,
            &:focus,
            &:hover {
                background: $accent 10%;

                &.active {
                    background: $accent 25%;
                }
            }
        }
    }
}

ListView {
    background: transparent;

    ListItem {
        height: auto;
        padding: 1;
    }

    & > .list-view--highlight {
        background: $boost;
    }

    &:focus > .list-view--highlight {
        background: $accent;
    }
}

.menu_item {
    padding: 1 2;
}

.pane {
    padding: 1 2;
    height: 1fr;
}

.page_header {
    height: auto;
    margin-bottom: 1;
}

.page_help {
    color: $text-muted;
    margin-bottom: 1;
}

.page_scroll {
    height: 1fr;
}


/* -------------------------------------------------------------------------- */
/*  Modals                                                                    */
/* -------------------------------------------------------------------------- */

/* Estilos compartidos para modales (formularios/confirmaciones) */

.modal {
    align: center middle;

    Label {
        margin-top: 1;
    }

    .modal_box {
        max-width: 100%;
        max-height: 100%;
        overflow: auto;

        height: auto;
        border: solid $accent;
        padding: 1 2;

        Input {
            border: solid $accent;

            &.error {
                border: solid $error;
            }
        }
    }

    .button_row {
        height: auto;
        margin-top: 1;
    }

    .button_row Button {
        width: 1fr;
    }

    .modal_w80 {
        width: 80;
    }

    .modal_w60 {
        width: 60;
    }

    .modal_h1fr {
        height: 1fr;
    }

    .modal_title {
        margin-bottom: 1;
    }

    .modal_help {
        color: $text-muted;
        margin-bottom: 1;
    }

    .modal_help_top {
        color: $text-muted;
        margin-top: 1;
    }

    .modal_error {
        margin-top: 1;
        height: auto;
    }

    .modal_row {
        height: auto;

        Input {
            width: 1fr;
        }

        Input:first-child {
            margin-right: 1;
        }
    }

    .modal_list {
        height: 1fr;
        border: solid $accent;
    }

    .hint {
        display: none;

        &.is-visible {
            display: block;
            color: $text-muted;
            margin-bottom: 1;
            height: auto;
        }
    }
}

/* -------------------------------------------------------------------------- */
/*  Events                                                                    */
/* -------------------------------------------------------------------------- */

#events_list {
    height: 1fr;
}

.event_list {
    .event_row {
        height: auto;

        .event_row_main {
            width: 1fr;
        }

        &.is_in_progress {
            .event_row_main {
                color: $accent;
                text-style: bold;
            }

            .event_notify {
                color: $accent;
                text-style: bold;
            }

            .event_row_notes {
                color: $accent;
            }
        }

        &.is_past {
            .event_row_main {
                color: $text-muted;
            }

            .event_notify {
                color: $text-muted;
            }

            .event_row_notes {
                color: $text-muted;
            }
        }
    }

    .event_row_notes {
        display: none;
        color: $text-muted;
        text-style: italic;
        padding-left: 4;
        height: auto;

        &.is-visible {
            display: block;
        }
    }
    .event_row_main_line {
        height: auto;
        margin-right: 1;
    }

    .event_notify {
        color: $accent;
        width: 2;
        margin-right: 1;
    }

    .event_repeat {
        width: auto;
        margin-left: 1;
        color: $text-muted;
    }
}

/* -------------------------------------------------------------------------- */
/*  Tasks                                                                     */
/* -------------------------------------------------------------------------- */

#tasks_list {
    height: 1fr;
}

.task_list {
    .task_list_row {
        width: 1fr;
        height: auto;
    }

    .task_status {
        width: auto;
        margin-right: 1;
    }

    .task_priority {
        width: auto;
        margin-right: 1;
        color: $error;
    }

    .task_title {
        width: 1fr;
    }

    .task_repeat {
        width: auto;
        margin-left: 1;
        color: $text-muted;
    }

    .task_due {
        width: auto;

        &.is_overdue {
            color: $error;
            text-style: bold;
        }
    }

    .task_link {
        width: auto;
        margin-left: 1;
        color: $text-muted;
        text-style: underline;

        &:hover,
        &:focus {
            color: $accent;
        }
    }

    .task_done {
        color: $text 35%;
    }

    .task_row_notes {
        display: none;
        color: $text-muted;
        text-style: italic;
        padding-left: 4;
        height: auto;

        &.is-visible {
            display: block;
        }
    }

    .task_subtask {
        .task_list_row {
            padding-left: 4;
        }

        .task_row_notes {
            padding-left: 6;
        }
    }
}

/* -------------------------------------------------------------------------- */
/*  Config / Help                                                             */
/* -------------------------------------------------------------------------- */

#config_list {
    height: auto;
    border: solid $accent;
}

.config_row {
    height: auto;

    Label {
        width: 1fr;
    }

    .config_value {
        width: auto;
        color: $text-muted;
    }
}

/* -------------------------------------------------------------------------- */
/*  Files                                                                     */
/* -------------------------------------------------------------------------- */

#files_list {
    height: 1fr;
}

/* -------------------------------------------------------------------------- */
/*  Journal                                                                   */
/* -------------------------------------------------------------------------- */

#journal_layout {
    height: 1fr;

    #journal_left {
        width: 22;
        margin-right: 2;
        height: 1fr;
    }

    #journal_right {
        width: 1fr;
        height: 1fr;
    }
}

#journal_history_list {
    height: 1fr;
}

#journal_detail_scroll {
    height: 1fr;
    border-left: solid $accent;
    padding: 1;
}

.journal_detail_title {
    height: auto;
    margin-left: 1;
}

.task_row {
    height: auto;

    Input {
        width: 1fr;
    }

    Input:first-child {
        margin-right: 1;
    }
}
